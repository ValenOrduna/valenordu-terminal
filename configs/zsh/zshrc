# =============================================================================
#  ValenOrdu Terminal Setup — .zshrc
#  Configuracion completa para zsh con plugins, aliases y herramientas
# =============================================================================

# -----------------------------------------------------------------------------
# PATH — directorios extra
# -----------------------------------------------------------------------------
export PATH="$PATH:$HOME/.local/bin"        # binarios locales
export PATH="$HOME/.opencode/bin:$PATH"     # opencode CLI

# -----------------------------------------------------------------------------
# Aliases — accesos directos
# -----------------------------------------------------------------------------

# Herramientas de IA
alias cl="claude"          # Claude CLI
alias co="codex"           # Codex CLI
alias op="opencode"        # Opencode CLI

# Git
alias lg="lazygit"         # TUI para git (ramas, commits, diffs, stash)

# eza — reemplazo de ls con colores, iconos y estado de git por archivo
alias ls="eza --icons --git --group-directories-first"
alias ll="eza -lh --icons --git --group-directories-first"
alias la="eza -lah --icons --git --group-directories-first"
alias lt="eza --tree --level=2 --icons --git"

# bat — reemplazo de cat con syntax highlighting y numeros de linea
alias cat="bat --paging=never"

# Delta como pager de git (diffs con colores lado a lado)
export GIT_PAGER="delta"

# -----------------------------------------------------------------------------
# Inicializacion de herramientas
# -----------------------------------------------------------------------------

# zoxide — cd inteligente, recuerda directorios frecuentes (usar: z <dir>)
eval "$(zoxide init zsh)"

# starship — prompt que muestra rama git, estado, lenguaje, etc.
eval "$(starship init zsh)"

# -----------------------------------------------------------------------------
# Experiencia tipo Warp en zsh
# -----------------------------------------------------------------------------

# Tab inteligente: menu navegable + ignora mayusculas/minusculas
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Sugerencias en gris segun tu historial (aceptas con ->)
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Ctrl+R = busqueda difusa de comandos anteriores | Ctrl+T = buscar archivos
source <(fzf --zsh)

# Resaltado de sintaxis (verde = ok, rojo = error). SIEMPRE al final del archivo.
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# -----------------------------------------------------------------------------
# Keybindings
# -----------------------------------------------------------------------------

bindkey -e                                         # modo emacs por defecto
bindkey "^[[1;3D" backward-word                    # Option + <-
bindkey "^[[1;3C" forward-word                     # Option + ->

# Shift+Select — seleccionar texto con shift+flechas (como editores normales)
source ~/.config/zsh/zsh-shift-select/zsh-shift-select.plugin.zsh
bindkey -M emacs '^[[1;6D' shift-select::backward-word
bindkey -M emacs '^[[1;6C' shift-select::forward-word
bindkey -M shift-select '^[[1;6D' shift-select::backward-word
bindkey -M shift-select '^[[1;6C' shift-select::forward-word

# -----------------------------------------------------------------------------
# ValenOrdu fetch — nombre 3D solido purpura + system info al abrir terminal
# -----------------------------------------------------------------------------
valenfetch() {
  clear
  figlet -f larry3d -w 300 "ValenOrdu" | while IFS= read -r line; do printf '\033[38;5;135m%s\033[0m\n' "$line"; done
  echo ""
  fastfetch --logo none
}
valenfetch
